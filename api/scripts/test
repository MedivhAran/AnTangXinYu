#!/usr/bin/env bash
set -Eeuo pipefail

api_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_dir="$(cd "$api_dir/.." && pwd)"
python="$api_dir/.venv/bin/python"
database_name="antang_test_$("$python" -c 'from uuid import uuid4; print(uuid4().hex)')"
database_created=0
child_pid=0

# Windows 进程可能把宿主机 TMP 传入 WSL；pytest 的临时文件固定留在 WSL。
export TMPDIR=/tmp

# 通过 PostgreSQL 连接管理临时库，兼容本地 Docker 与 CI 的独立数据库进程。
database_command() (
    cd "$api_dir"
    "$python" - "$1" "$database_name" <<'PY'
import sys

import psycopg
from psycopg import sql
from sqlalchemy.engine import make_url

from antang_api.settings import settings

admin_url = make_url(settings.database_url).set(
    drivername="postgresql", database="postgres"
).render_as_string(hide_password=False)
statements = {
    "create": "CREATE DATABASE {}",
    "drop": "DROP DATABASE IF EXISTS {} WITH (FORCE)",
}
with psycopg.connect(admin_url, autocommit=True) as connection:
    connection.execute(sql.SQL(statements[sys.argv[1]]).format(sql.Identifier(sys.argv[2])))
PY
)

cleanup() {
    status=$?
    trap - EXIT

    if (( database_created )); then
        if database_command drop
        then
            echo "Removed temporary test database: $database_name"
        else
            echo "Failed to remove temporary test database: $database_name" >&2
            status=1
        fi
    fi

    exit "$status"
}

forward_signal() {
    signal_name=$1
    status=$2

    if (( child_pid )); then
        kill -s "$signal_name" "$child_pid" 2>/dev/null || true
        wait "$child_pid" 2>/dev/null || true
        child_pid=0
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

cd "$project_dir"
database_command create
database_created=1

test_database_url="$(
    cd "$api_dir"
    ANTANG_TEST_DATABASE="$database_name" "$python" -c '
import os

from sqlalchemy.engine import make_url

from antang_api.settings import settings

print(
    make_url(settings.database_url)
    .set(database=os.environ["ANTANG_TEST_DATABASE"])
    .render_as_string(hide_password=False)
)
'
)"
export DATABASE_URL="$test_database_url"

echo "Temporary test database: $database_name"
cd "$api_dir"
"$python" -m alembic upgrade head &
child_pid=$!
wait "$child_pid"
child_pid=0

"$python" -m pytest "$@" &
child_pid=$!
wait "$child_pid"
child_pid=0
