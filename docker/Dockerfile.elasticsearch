# Elasticsearch + IK 中文分词插件，版本随 ES_VERSION 对齐。
# IK 插件版本必须与 ES 完全一致；这里用 infinilabs 的 get 服务按版本取对应包。
# 若该 ES 版本拿不到 IK 包导致构建失败，把 ES_VERSION 换成相近的 8.x 版本即可。
ARG ES_VERSION=8.19.0
FROM docker.elastic.co/elasticsearch/elasticsearch:${ES_VERSION}

ARG ES_VERSION
RUN elasticsearch-plugin install --batch https://get.infini.cloud/elasticsearch/analysis-ik/${ES_VERSION}
