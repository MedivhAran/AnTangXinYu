# 跨平台文本文件统一为 LF（避免 Windows clone 后 shell 脚本行尾变成 CRLF 在容器里报错）
* text=auto eol=lf

# 强制 LF 的脚本与配置
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf

# Windows 批处理保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件（不做行尾转换）
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.lock binary
