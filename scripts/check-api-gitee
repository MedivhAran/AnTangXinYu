#!/usr/bin/env bash
set -Eeuo pipefail

# 仅供 Gitee 的临时 Ubuntu 构建容器使用；本地请运行 scripts/check api。
[[ "${CI:-}" == 1 ]] || { echo '此脚本仅用于 CI 临时容器。' >&2; exit 2; }
export DEBIAN_FRONTEND=noninteractive
. /etc/os-release
install -d /usr/share/postgresql-common/pgdg /etc/postgresql-common
curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
cat > /etc/apt/sources.list.d/pgdg.sources <<EOF
Types: deb
URIs: https://mirrors.aliyun.com/postgresql/repos/apt
Suites: ${VERSION_CODENAME}-pgdg
Components: main
Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
EOF
apt-get update -qq
apt-get install -y --no-install-recommends postgresql-common
echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.conf
apt-get install -y --no-install-recommends postgresql-18

pg_createcluster 18 antang_check --start -- --auth-host=scram-sha-256 --auth-local=peer
trap 'pg_dropcluster --stop 18 antang_check' EXIT
runuser -u postgres -- psql -v ON_ERROR_STOP=1 -c \
    "CREATE ROLE antang_check WITH LOGIN SUPERUSER PASSWORD 'local-check-only'"
export ANTANG_CHECK_DATABASE_URL=postgresql+psycopg://antang_check:local-check-only@127.0.0.1:5432/postgres

# frozen sync 固定下载源；导出相同版本和哈希后，从国内镜像安装。
uv export --project api --frozen --no-emit-project --format requirements-txt \
    --output-file /tmp/antang-ci-requirements.txt --quiet
uv venv api/.venv --python 3.12
uv pip sync --python api/.venv/bin/python --require-hashes \
    --index-url https://mirrors.aliyun.com/pypi/simple/ /tmp/antang-ci-requirements.txt
uv pip install --python api/.venv/bin/python --no-deps \
    --index-url https://mirrors.aliyun.com/pypi/simple/ --editable ./api
bash scripts/check api --no-sync
